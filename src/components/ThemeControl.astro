<div id="theme-control" role="group" aria-label="화면 테마" hidden>
  <button type="button" data-theme-choice="light" title="라이트 모드" aria-label="라이트 모드" aria-pressed="false">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
  </button>
  <button type="button" data-theme-choice="dark" title="다크 모드" aria-label="다크 모드" aria-pressed="false">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z"/></svg>
  </button>
</div>

<script>
  const control = document.querySelector<HTMLElement>('#theme-control');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
  type Theme = 'light' | 'dark';
  const parseTheme = (value: string | null): Theme | null =>
    value === 'light' || value === 'dark' ? value : null;
  let preference: Theme | null = null;
  try { preference = parseTheme(localStorage.getItem('theme')); } catch {}

  function applyTheme() {
    const theme = preference ?? (systemTheme.matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme));
    });
  }

  if (control) {
    applyTheme();
    control.hidden = false;
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        preference = parseTheme(button.dataset.themeChoice ?? null);
        try { localStorage.setItem('theme', preference!); } catch {}
        applyTheme();
      });
    });
    systemTheme.addEventListener('change', () => {
      if (!preference) applyTheme();
    });
    window.addEventListener('storage', (event) => {
      if (event.key !== 'theme' && event.key !== null) return;
      preference = parseTheme(event.newValue);
      applyTheme();
    });
  }
</script>
